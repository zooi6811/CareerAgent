# Optional provider keys. The same keys can be set for this session in Agent Controls.
# Server-side only. Never expose these to the client.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GROQ_API_KEY="MY_GROQ_API_KEY"
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# Active text-generation provider: gemini, groq, or openrouter.
AI_PROVIDER="gemini"

# Provider-specific model IDs. Free-tier model availability and limits can change.
# OpenRouter's openrouter/free router selects a currently available free model.
GEMINI_MODEL="gemini-3.8-flash"
GROQ_MODEL="openai/gpt-oss-20b"
OPENROUTER_MODEL="openrouter/free"

# Per-request model timeout (AbortSignal). Default 45000.
GEMINI_TIMEOUT_MS="45000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
